# functions/.env — non-secret params for the Cloud Functions (2nd gen).
#
# firebase-functions reads defineString() params from this file at deploy time.
# Copy to functions/.env and fill in. Only NON-secret values belong here — the
# VAPID *private* key is a Secret Manager secret, set separately with:
#   firebase functions:secrets:set VAPID_PRIVATE
#
# Generate the key pair with:  npx web-push generate-vapid-keys

# Public VAPID key (same value the web app ships as VITE_VAPID_PUBLIC_KEY).
VAPID_PUBLIC=

# Contact address the push services use to reach you about your pushes.
VAPID_SUBJECT=mailto:support@midjdeal.com

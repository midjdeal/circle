# Web app env — copy to .env.local (git-ignored) and fill in.
# Vite exposes only variables prefixed with VITE_ to the client bundle.

# Public VAPID key for Web Push. Generate a pair with:
#   npx web-push generate-vapid-keys
# The PUBLIC key goes here (it ships to clients — not a secret). The matching
# PRIVATE key goes into the functions' Secret Manager secret VAPID_PRIVATE
# (see functions/.env.example). Push subscription is skipped when this is unset.
VITE_VAPID_PUBLIC_KEY=
